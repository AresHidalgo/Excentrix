---
import type { GetStaticPaths } from 'astro';
import { routes } from '@shared/config/routes';
import Container from '@shared/ui/Container.astro';
import SectionHeading from '@shared/ui/SectionHeading.astro';
import { getPerfumes, getRelatedPerfumes, ProductRow } from '@modules/catalog';
import { StoreLayout } from '@modules/content';
import {
  Gallery,
  HOUSE_LABEL,
  OlfactoryPyramid,
  PerfumeDetails,
  perfumeTitle,
  ProductInfo,
  type Perfume,
} from '@modules/product';

export const getStaticPaths = (() =>
  getPerfumes().map((perfume) => ({
    params: { slug: perfume.slug },
    props: { perfume },
  }))) satisfies GetStaticPaths;

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const related = getRelatedPerfumes(getPerfumes(), perfume);
const hasNotes = [perfume.notes.top, perfume.notes.heart, perfume.notes.base].some(
  (n) => n.length > 0,
);
---

<StoreLayout
  title={`${perfumeTitle(perfume)} (maqueta)`}
  description={perfume.description}
  hideWhatsAppFloatOnMobile={true}
  whatsappMessage={`Hola Excentrix, tengo una pregunta sobre el perfume ${perfumeTitle(perfume).replace(/^I/, 'i')}.`}
  noindex
>
  <Container class="pt-6 pb-16 sm:pt-10 sm:pb-24">
    <nav aria-label="Ruta de navegación" class="mb-6 sm:mb-10">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-ink-soft">
        <li>
          <a href={routes.home} class="hover:text-ink">
            Inicio
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={routes.collection(perfume.house)} class="hover:text-ink">
            {HOUSE_LABEL[perfume.house]}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">
          {perfume.name}
        </li>
      </ol>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16 xl:gap-24">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <Gallery perfume={perfume} />
      </div>
      <ProductInfo perfume={perfume} />
    </div>
  </Container>

  {hasNotes && (
    <div class="border-t border-line bg-white py-16 sm:py-24">
      <Container>
        <OlfactoryPyramid notes={perfume.notes} />
      </Container>
    </div>
  )}

  <Container class="py-16 sm:py-24">
    <PerfumeDetails perfume={perfume} />
  </Container>

  <section class="border-t border-line py-16 sm:py-24" aria-labelledby="relacionados-titulo">
    <Container class="flex flex-col gap-12">
      <SectionHeading
        id="relacionados-titulo"
        eyebrow="También te puede gustar"
        title="Perfumes relacionados"
        link={{
          href: routes.collection(perfume.house),
          label: `Ver ${HOUSE_LABEL[perfume.house]}`,
        }}
      />
      <ProductRow perfumes={related} label="Perfumes relacionados" />
    </Container>
  </section>
</StoreLayout>
