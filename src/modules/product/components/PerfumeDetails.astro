---
import { CONCENTRATION_LABEL, GENDER_LABEL, HOUSE_LABEL } from '../lib/labels';
import type { Perfume } from '../schemas';

interface Props {
  perfume: Perfume;
  class?: string;
}

const { perfume, class: className } = Astro.props;
const details = [
  { term: 'Marca', value: perfume.brand },
  {
    term: 'Concentración',
    value: `${CONCENTRATION_LABEL[perfume.concentration]} (${perfume.concentration})`,
  },
  { term: 'Familia olfativa', value: perfume.olfactoryFamily.join(', ') },
  { term: 'Género', value: GENDER_LABEL[perfume.gender] },
  { term: 'Casa', value: HOUSE_LABEL[perfume.house] },
];
---

<section
  aria-labelledby="descripcion-titulo"
  class:list={['grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20', className]}
>
  <div class="flex flex-col gap-5">
    <h2 id="descripcion-titulo" class="text-3xl leading-tight sm:text-4xl">
      Sobre el perfume
    </h2>
    <p class="max-w-prose text-base leading-relaxed text-ink-soft">{perfume.description}</p>
  </div>
  <dl class="grid grid-cols-1 border-t border-line sm:grid-cols-2 sm:gap-x-10">
    {details.map((d) => (
      <div class="flex flex-col gap-1 border-b border-line py-5">
        <dt class="eyebrow text-[10px] text-ink-soft">{d.term}</dt>
        <dd class="text-sm text-ink first-letter:uppercase">{d.value}</dd>
      </div>
    ))}
  </dl>
</section>
