---
import Container from '@shared/ui/Container.astro';
import Icon from '@shared/ui/Icon.astro';
import SectionHeading from '@shared/ui/SectionHeading.astro';

import type { CollectionTile } from '../../schemas';

interface Props {
  tiles: CollectionTile[];
}

const { tiles } = Astro.props;
---

<section class="py-20 sm:py-28" aria-labelledby="colecciones-titulo">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      id="colecciones-titulo"
      eyebrow="Colecciones"
      title="Encuentra tu tipo de perfumería"
      description="Desde casas de autor hasta los clásicos de diseñador y la intensidad de los perfumes árabes."
    />
    <ul class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {tiles.map((tile, i) => (
        <li>
          <a
            href={tile.href}
            class="group flex h-full min-h-60 flex-col justify-between gap-12 bg-white p-6 transition-colors duration-500 ease-(--ease-luxe) hover:bg-ink hover:text-white sm:min-h-72 sm:p-8"
          >
            <div class="flex items-center justify-between">
              <span class="price text-xs text-crimson transition-colors group-hover:text-crimson-light">
                0{i + 1}
              </span>
              <span class="eyebrow text-[10px] text-ink-soft transition-colors group-hover:text-white/70">
                {tile.count} perfumes
              </span>
            </div>
            <div class="flex flex-col gap-3">
              <h3 class="text-4xl leading-none sm:text-5xl">{tile.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft transition-colors group-hover:text-white/70">
                {tile.description}
              </p>
              <span class="mt-2 flex items-center gap-3">
                <span class="h-px w-8 bg-crimson transition-[width] duration-500 ease-(--ease-luxe) group-hover:w-14 group-hover:bg-crimson-light" />
                <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>
