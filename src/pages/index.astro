---
import { routes } from '@shared/config/routes';
import {
  countCollection,
  getCatalogSizes,
  getCollectionPerfumes,
  getPerfumes,
} from '@modules/catalog';
import {
  getMockSettings,
  HowToBuy,
  InstagramStrip,
  LoyaltyCard,
  NewArrivals,
  PrestigeCollection,
  StoreLayout,
} from '@modules/content';
import {
  INSPIRED_NOTICE,
  LINE_COLLECTION,
  LINE_LABEL,
  LINE_ORDER,
  LINE_SUMMARY,
} from '@modules/product';
import ExcentrixHero from '@modules/content/components/home/ExcentrixHero.astro';

const perfumes = getPerfumes();
const settings = getMockSettings();

// Textos de la página 1 del catálogo PDF ("Colección Prestigio").
const houses = [
  {
    slug: 'disenador',
    title: 'Diseñador',
    text: 'Íconos de la moda global: aromas de prestigio que definen épocas.',
  },
  {
    slug: 'nicho',
    title: 'Nicho',
    text: 'Exclusividad olfativa y creaciones audaces para el espíritu exigente.',
  },
  {
    slug: 'arabe',
    title: 'Árabe',
    text: 'La opulencia del desierto: ámbar, oud y especias con una estela rica.',
  },
].map((h) => ({ ...h, href: routes.collection(h.slug), count: countCollection(h.slug) }));

const lines = LINE_ORDER.map((line) => ({
  title: LINE_LABEL[line],
  text: LINE_SUMMARY[line],
  href: routes.collection(LINE_COLLECTION[line].slug),
  count: countCollection(LINE_COLLECTION[line].slug),
}));

const genders = [
  { slug: 'hombre', title: 'Masculinos', text: 'Fragancias intensas y seductoras.' },
  { slug: 'mujer', title: 'Femeninos', text: 'Aromas delicados y envolventes.' },
  { slug: 'unisex', title: 'Unisex', text: 'El equilibrio perfecto para todos.' },
].map((g) => ({ ...g, href: routes.collection(g.slug), count: countCollection(g.slug) }));

const newArrivals = getCollectionPerfumes(perfumes, 'nuevos-lanzamientos', 'novedades').slice(0, 4);
---

<StoreLayout>
  <ExcentrixHero />
  <LoyaltyCard />
  <PrestigeCollection
    total={perfumes.length}
    lines={lines}
    houses={houses}
    genders={genders}
    sizes={getCatalogSizes()}
    notice={INSPIRED_NOTICE}
  />
  {newArrivals.length > 0 && <NewArrivals perfumes={newArrivals} />}
  <HowToBuy />
  <InstagramStrip href={settings.social.instagram} handle={settings.social.handle} />
</StoreLayout>
