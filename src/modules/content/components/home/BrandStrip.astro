---
import Container from '@shared/ui/Container.astro';
import type { Brand } from '@modules/catalog';

interface Props {
  brands: Brand[];
}

const { brands } = Astro.props;
---

<section class="border-t border-line py-16 sm:py-20" aria-labelledby="marcas-titulo">
  <Container class="flex flex-col items-center gap-10">
    <h2 id="marcas-titulo" class="eyebrow flex items-center gap-3 font-sans! text-ink-soft">
      <span aria-hidden="true" class="h-px w-8 bg-crimson"></span>
      Marcas destacadas
      <span aria-hidden="true" class="h-px w-8 bg-crimson"></span>
    </h2>
    <ul class="flex max-w-5xl flex-wrap items-baseline justify-center gap-x-10 gap-y-6 sm:gap-x-14">
      {brands.map((b, i) => (
        <li
          class:list={[
            'text-ink-soft transition-colors hover:text-ink',
            i % 2 === 0
              ? 'font-display text-2xl sm:text-3xl'
              : 'text-xs font-medium tracking-(--tracking-brand) uppercase sm:text-sm',
          ]}
        >
          {b.name}
        </li>
      ))}
    </ul>
  </Container>
</section>
