---
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import Container from '@shared/ui/Container.astro';
import { routes } from '@shared/config/routes';
import { collectionCategories, getMockCategories, getPerfumes } from '@modules/catalog';
import { getMockPages } from '@modules/content';

const groups = [
  {
    title: 'Páginas',
    links: [
      { label: 'Inicio', href: routes.home },
      { label: 'Sistema de diseño', href: '/maquetas/sistema' },
      { label: 'Dashboard de administrador', href: '/maquetas/admin' },
    ],
  },
  {
    title: 'Colecciones',
    links: collectionCategories(getMockCategories()).map((c) => ({
      label: c.name,
      href: routes.collection(c.slug),
    })),
  },
  {
    title: 'Fichas de perfume',
    links: getPerfumes().map((p) => ({
      label: `${p.name} · ${p.brand}`,
      href: routes.perfume(p.slug),
    })),
  },
  {
    title: 'Contenido',
    links: getMockPages().map((p) => ({ label: p.title, href: routes.page(p.slug) })),
  },
];
---

<BaseLayout title="Maquetas" noindex>
  <Container as="main" class="py-16 sm:py-24">
    <header class="flex flex-col gap-6 border-b border-line pb-12">
      <img
        src="/brand/logo-horizontal.svg"
        alt="Excentrix Perfumería"
        width="1462"
        height="425"
        class="h-12 w-auto self-start"
      />
      <p class="eyebrow flex items-center gap-3 text-ink-soft">
        <span aria-hidden="true" class="h-px w-8 bg-crimson"></span>
        Fase 1 · Diseño
      </p>
      <h1 class="text-5xl sm:text-6xl">Maquetas</h1>
      <p class="max-w-xl text-ink-soft">
        Componentes reales con datos de ejemplo. Estas páginas no se indexan ni aparecen en el
        sitemap.
      </p>
    </header>
    <div class="grid gap-12 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((g) => (
        <section class="flex flex-col gap-4">
          <h2 class="eyebrow font-sans! text-ink-soft">{g.title}</h2>
          <ul class="flex flex-col divide-y divide-line border-y border-line">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="block py-3 text-sm transition-colors hover:text-crimson">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </Container>
</BaseLayout>
