---
import { routes } from '@shared/config/routes';
import {
  getCollectionPerfumes,
  getMockBrands,
  getMockCategories,
  getMockPerfumes,
} from '@modules/catalog';
import {
  BrandStrip,
  CollectionTiles,
  DecantExplainer,
  GenderTiles,
  getMockSettings,
  HowToBuy,
  InstagramStrip,
  NewArrivals,
  StoreLayout,
} from '@modules/content';
import type { BottleShape } from '@modules/product';
import ExcentrixHero from '@modules/content/components/home/ExcentrixHero.astro';

const perfumes = getMockPerfumes();
const categories = getMockCategories();
const settings = getMockSettings();
const describe = (slug: string) => categories.find((c) => c.slug === slug);
const count = (slug: string) => getCollectionPerfumes(perfumes, slug).length;

const collectionTiles = ['nicho', 'disenador', 'arabe', 'decants'].map((slug) => ({
  title: describe(slug)?.name ?? slug,
  description: describe(slug)?.description ?? '',
  href: routes.collection(slug),
  count: count(slug),
}));

const shapes: Record<string, BottleShape> = { hombre: 'tall', mujer: 'round', unisex: 'oud' };
const genderTiles = ['hombre', 'mujer', 'unisex'].map((slug) => ({
  title: describe(slug)?.name ?? slug,
  href: routes.collection(slug),
  count: count(slug),
  shape: shapes[slug] ?? 'tall',
}));

const newArrivals = getCollectionPerfumes(perfumes, 'nuevos-lanzamientos', 'novedades').slice(0, 4);
---

<StoreLayout title="Inicio (maqueta)" noindex>
  <ExcentrixHero />
  <CollectionTiles tiles={collectionTiles} />
  <NewArrivals perfumes={newArrivals} />
  <GenderTiles tiles={genderTiles} />
  <DecantExplainer />
  <HowToBuy />
  <BrandStrip brands={getMockBrands()} />
  <InstagramStrip href={settings.social.instagram} handle={settings.social.handle} />
</StoreLayout>
