---
import { isAvailable, type Perfume } from '@modules/product';

interface Props {
  perfumes: Perfume[];
}

const { perfumes } = Astro.props;
const stats = [
  { label: 'Publicados', value: perfumes.length },
  { label: 'Borradores', value: 2 },
  { label: 'Agotados', value: perfumes.filter((p) => !isAvailable(p)).length },
  { label: 'Último build', value: 'Listo' },
];
---

<section aria-label="Resumen">
  <dl class="grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-4">
    {stats.map((s) => (
      <div class="flex flex-col gap-1 bg-white p-5">
        <dt class="text-xs text-ink-soft">{s.label}</dt>
        <dd class="price text-2xl font-semibold">{s.value}</dd>
      </div>
    ))}
  </dl>
</section>
