---
import { buttonClass } from '@shared/ui/styles';

interface Props {
  title?: string;
  message?: string;
  /** Muestra el botón "Limpiar filtros" (la isla de filtros escucha data-clear-filters). */
  showClear?: boolean;
  action?: { href: string; label: string };
}

const {
  title = 'No encontramos perfumes con estos filtros',
  message = 'Prueba quitando alguno de los filtros o explora otra colección.',
  showClear = true,
  action,
} = Astro.props;
---

<div class="flex flex-col items-center gap-5 border border-line bg-white px-6 py-16 text-center sm:py-24">
  <span aria-hidden="true" class="h-px w-12 bg-crimson"></span>
  <h2 class="max-w-md text-2xl leading-snug sm:text-3xl">{title}</h2>
  <p class="max-w-sm text-sm leading-relaxed text-ink-soft">{message}</p>
  <div class="mt-2 flex flex-wrap justify-center gap-3">
    {showClear && (
      <button type="button" class={buttonClass('primary', 'md')} data-clear-filters>
        Limpiar filtros
      </button>
    )}
    {action && (
      <a href={action.href} class={buttonClass('outline', 'md')}>
        {action.label}
      </a>
    )}
  </div>
</div>
