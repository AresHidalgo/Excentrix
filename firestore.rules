rules_version = '2';

// Excentrix — reglas de Firestore
// Lectura pública solo de lo publicado; escritura solo para usuarios con custom claim admin == true.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /perfumes/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      // El id del documento es el slug (la URL del perfume): deben coincidir.
      allow create, update: if isAdmin() && request.resource.data.slug == id;
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if id == 'site' || isAdmin();
      allow write: if isAdmin();
    }

    // Todo lo demás: cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
