---
import { CONCENTRATION_LABEL, GENDER_LABEL, INSPIRED_NOTICE } from '../lib/labels';
import type { Perfume } from '../schemas';
import PerfumeBadges from './PerfumeBadges.astro';
import PurchasePanel from './PurchasePanel.astro';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;

// Línea secundaria: concentración y familias cuando se conocen; si no, el género.
const meta = [
  perfume.concentration ? CONCENTRATION_LABEL[perfume.concentration] : null,
  ...perfume.olfactoryFamily,
].filter(Boolean);
const metaLine = meta.length > 0 ? meta.join(' · ') : `Fragancia ${GENDER_LABEL[perfume.gender]}`;

// Garantías: distintas para versiones inspiradas (nunca se promete "original").
const promises = perfume.inspired
  ? [
      {
        title: 'Versión inspirada',
        text: `Fragancia inspirada en ${perfume.name} de ${perfume.brand}. No es el producto de la marca.`,
      },
      { title: 'Tres tamaños', text: '30, 60 y 100 ml al mismo precio para todo el catálogo.' },
      { title: 'Envíos', text: 'A toda Colombia. Coordinamos por WhatsApp.' },
    ]
  : [
      { title: 'Originales', text: 'Frascos sellados o tester, siempre originales.' },
      {
        title: 'Decants al momento',
        text: 'Envasados del frasco original en atomizador de vidrio.',
      },
      { title: 'Envíos', text: 'A toda Colombia. Coordinamos por WhatsApp.' },
    ];
---

<div class="flex flex-col gap-8">
  <div class="flex flex-col gap-4">
    <p class="eyebrow text-ink-soft">
      {perfume.inspired ? `Inspirado en · ${perfume.brand}` : perfume.brand}
    </p>
    <h1 class="text-4xl leading-[1.05] sm:text-5xl">
      {perfume.inspired && <span class="sr-only">Inspirado en </span>}
      {perfume.name}
      {perfume.inspired && <span class="sr-only"> de {perfume.brand}</span>}
    </h1>
    <p class="text-sm text-ink-soft">{metaLine}</p>
    <PerfumeBadges perfume={perfume} />
  </div>

  <hr class="h-px border-0 bg-line" />

  <PurchasePanel perfume={perfume} />

  <ul class="grid gap-3 border-t border-line pt-6 text-xs text-ink-soft sm:grid-cols-3">
    {promises.map((p) => (
      <li class="flex flex-col gap-1">
        <span class="eyebrow text-[10px] text-ink">{p.title}</span>
        {p.text}
      </li>
    ))}
  </ul>

  {perfume.inspired && <p class="text-[11px] leading-relaxed text-ink-soft">{INSPIRED_NOTICE}</p>}
</div>
