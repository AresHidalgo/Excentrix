---
import Container from '@shared/ui/Container.astro';
import Icon from '@shared/ui/Icon.astro';
import SectionHeading from '@shared/ui/SectionHeading.astro';
import { ProductImage } from '@modules/product';

import type { GenderTile } from '../../schemas';

interface Props {
  tiles: GenderTile[];
}

const { tiles } = Astro.props;
---

<section class="bg-white py-20 sm:py-28" aria-labelledby="genero-titulo">
  <Container class="flex flex-col gap-12">
    <SectionHeading id="genero-titulo" eyebrow="Por género" title="Para cada piel" />
    <ul class="grid gap-3 sm:grid-cols-3 sm:gap-5">
      {tiles.map((tile, i) => (
        <li>
          <a href={tile.href} class="group block border border-line bg-paper">
            <div class="overflow-hidden">
              <ProductImage
                alt=""
                shape={tile.shape}
                variant={i === 1 ? 'ambiente' : 'detalle'}
                class="transition-transform duration-700 ease-(--ease-luxe) group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex items-end justify-between gap-4 border-t border-line p-5 sm:p-6">
              <div class="flex flex-col gap-1">
                <h3 class="text-3xl leading-none sm:text-4xl">{tile.title}</h3>
                <span class="eyebrow text-[10px] text-ink-soft">{tile.count} perfumes</span>
              </div>
              <Icon
                name="arrow-right"
                size={20}
                class="mb-1 transition-transform duration-300 group-hover:translate-x-1"
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>
