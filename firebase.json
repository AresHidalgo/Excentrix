{
  "hosting": [
    {
      "site": "excentrix",
      "public": "dist",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            }
          ]
        },
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/brand/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "/admin{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/maquetas/inicio",
          "destination": "/",
          "type": 301
        },
        {
          "regex": "^/maquetas/(?P<seccion>coleccion|perfume|contenido)/(?P<slug>[^/]+)$",
          "destination": "/:seccion/:slug",
          "type": 301
        }
      ]
    },
    {
      "site": "excentrix-e7794",
      "public": "hosting-redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://excentrix.web.app/",
          "type": 301
        },
        {
          "regex": "^/(?P<path>.*)$",
          "destination": "https://excentrix.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "database": "default",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
