# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Dominio público del sitio (canónicas, sitemap, Open Graph, enlaces de WhatsApp)
PUBLIC_SITE_URL=https://excentrix.web.app

# Firebase (configuración web, es pública por diseño; la seguridad la dan las reglas)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudinary: cloud name y API Key son públicos (los usa el selector de imágenes del admin).
# El API Secret NUNCA va aquí ni en el navegador.
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_API_KEY=

# Scripts locales de Firebase (pnpm firebase:seed / firebase:admin): ruta al JSON de la cuenta
# de servicio, fuera de git.
GOOGLE_APPLICATION_CREDENTIALS=

# Build en CI: la misma cuenta de servicio como JSON en una línea (va en GitHub Secrets).
FIREBASE_SERVICE_ACCOUNT=
