---
import { perfumeAlt } from '../lib/labels';
import type { Perfume } from '../schemas';
import ProductImage from './ProductImage.astro';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const baseAlt = perfumeAlt(perfume.name, perfume.brand, undefined, perfume.inspired);

type Slide = { src?: string; alt: string; variant: 'principal' | 'detalle' | 'ambiente' };
const slides: Slide[] =
  perfume.images.length > 0
    ? perfume.images.map((img) => ({
        src: img.src,
        alt: img.alt,
        variant: img.kind === 'ambiente' ? 'ambiente' : 'principal',
      }))
    : [
        { alt: baseAlt, variant: 'principal' },
        { alt: `${baseAlt}, detalle de la tapa`, variant: 'detalle' },
        { alt: `${baseAlt}, foto de ambiente`, variant: 'ambiente' },
      ];
---

<div class="flex flex-col gap-3" data-gallery>
  <div
    class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-gallery-track
    tabindex="0"
    role="region"
    aria-roledescription="carrusel"
    aria-label={`Fotos de ${perfume.name}`}
  >
    {slides.map((slide, i) => (
      <figure
        class="w-full shrink-0 snap-center bg-white"
        aria-label={`Foto ${i + 1} de ${slides.length}`}
        data-gallery-slide
      >
        <ProductImage
          src={slide.src}
          alt={slide.alt}
          shape={perfume.shape}
          variant={slide.variant}
          loading={i === 0 ? 'eager' : 'lazy'}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </figure>
    ))}
  </div>

  <div class="grid grid-cols-4 gap-3 sm:grid-cols-5">
    {slides.map((slide, i) => (
      <button
        type="button"
        class="border border-transparent bg-white opacity-60 transition-[opacity,border-color] duration-300 hover:opacity-100 aria-current:border-ink aria-current:opacity-100"
        aria-label={`Ver foto ${i + 1}`}
        aria-current={i === 0 ? 'true' : undefined}
        data-gallery-thumb={i}
      >
        <ProductImage
          src={slide.src}
          alt=""
          shape={perfume.shape}
          variant={slide.variant}
          sizes="120px"
        />
      </button>
    ))}
  </div>
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
    if (!track) continue;

    const setCurrent = (index: number) => {
      thumbs.forEach((t, i) => {
        if (i === index) t.setAttribute('aria-current', 'true');
        else t.removeAttribute('aria-current');
      });
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
        setCurrent(i);
      });
    });

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() =>
        setCurrent(Math.round(track.scrollLeft / Math.max(track.clientWidth, 1))),
      );
    });
  }
</script>
