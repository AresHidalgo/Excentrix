---
/**
 * ExcentrixHero — hero animado: intro de carga + animación ligada al scroll.
 * Portado desde la pieza de diseño "excentrix-hero" (HTML + CSS + JS vanilla).
 *
 * - Estilos aislados: CSS con alcance de Astro y prefijo `ex-` en clases y animaciones.
 * - El header del sitio se mantiene: el `.nav` original no se incluye.
 * - Comportamiento: el elemento `<ex-hero>` registra los listeners de scroll/resize al
 *   conectarse y los retira (cancelando el requestAnimationFrame) al desconectarse.
 * - Fuentes (Cormorant Garamond y Montserrat) cargadas solo por este componente.
 */
const asset = (name: string) => `/excentrix-hero/${name}`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Montserrat:wght@300;400;500&display=swap"
/>

<ex-hero class="ex" data-ch="0">
  <div class="ex-pre" aria-hidden="true">
    <div class="ex-pre-iso">
      <img class="ex-pre-bottle" src={asset('excentrix-frasco.svg')} alt="" />
      <img class="ex-pre-swirl" src={asset('excentrix-estela.svg')} alt="" />
    </div>
    <img class="ex-pre-word" src={asset('excentrix-wordmark.svg')} alt="" />
    <div class="ex-pre-bar">
      <i></i>
    </div>
  </div>

  <section class="ex-stage" data-stage aria-label="Presentación Excentrix">
    <div class="ex-pin">
      <div class="ex-glow" aria-hidden="true"></div>
      <div class="ex-outline ex-serif" aria-hidden="true">
        Excentrix · Perfumería · Excentrix
      </div>

      <div class="ex-puffs" aria-hidden="true">
        <div class="ex-puff" style="--x: 58%; --s: 180px; --dur: 9s; --dl: 0s"></div>
        <div class="ex-puff" style="--x: 72%; --s: 120px; --dur: 7s; --dl: 1.5s"></div>
        <div class="ex-puff" style="--x: 64%; --s: 240px; --dur: 11s; --dl: 3s"></div>
        <div class="ex-puff" style="--x: 82%; --s: 150px; --dur: 8s; --dl: 4.5s"></div>
        <div class="ex-puff" style="--x: 50%; --s: 110px; --dur: 10s; --dl: 6s"></div>
        <div class="ex-puff" style="--x: 30%; --s: 140px; --dur: 12s; --dl: 2s"></div>
      </div>

      <div class="ex-iso-wrap">
        <div class="ex-iso ex-bottle-in">
          <img
            class="ex-swirl-ghost"
            src={asset('excentrix-estela.svg')}
            alt=""
            aria-hidden="true"
          />
          <img src={asset('excentrix-frasco.svg')} alt="Frasco de perfume Excentrix quebrándose" />
          <img class="ex-swirl" src={asset('excentrix-estela.svg')} alt="" aria-hidden="true" />
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 62%; top: 24%; width: 7%; height: 9%; clip-path: polygon(0 0, 100% 30%, 40% 100%); --dx: 90px; --dy: -120px; --r: 140deg"
          ></div>
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 70%; top: 31%; width: 5%; height: 6%; clip-path: polygon(20% 0, 100% 60%, 0 100%); --dx: 160px; --dy: -40px; --r: -200deg"
          ></div>
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 66%; top: 38%; width: 4%; height: 5%; clip-path: polygon(0 20%, 100% 0, 60% 100%); --dx: 130px; --dy: 60px; --r: 260deg"
          ></div>
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 74%; top: 20%; width: 3%; height: 4%; clip-path: polygon(50% 0, 100% 100%, 0 80%); --dx: 200px; --dy: -160px; --r: -120deg"
          ></div>
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 8%; top: 44%; width: 4%; height: 4%; clip-path: polygon(0 0, 100% 40%, 30% 100%); --dx: -150px; --dy: -50px; --r: 180deg"
          ></div>
          <div
            class="ex-shard"
            aria-hidden="true"
            style="left: 12%; top: 52%; width: 3%; height: 3%; clip-path: polygon(30% 0, 100% 100%, 0 70%); --dx: -110px; --dy: 90px; --r: -240deg"
          ></div>
        </div>
      </div>

      <div class="ex-copy">
        <div class="ex-ch ex-ch0">
          <p class="ex-eyebrow ex-in" style="--d: .1s">
            Perfumería de nicho
          </p>
          <h1 class="ex-h1 ex-serif">
            <span class="ex-line">
              <span style="--d: .15s">Rompe</span>
            </span>
            <span class="ex-line">
              <span style="--d: .28s">
                el <em>molde.</em>
              </span>
            </span>
          </h1>
          <p class="ex-lead ex-in" style="--d: .55s">
            Fragancias de autor para quienes no pasan desapercibidos. Aromas intensos, únicos y
            hechos para dejar huella.
          </p>
          <div class="ex-ctas ex-in" style="--d: .7s">
            <a class="ex-btn ex-btn-primary" href="#coleccion">
              Explorar colección{' '}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a class="ex-btn ex-btn-ghost" href="#coleccion">
              Encuentra tu aroma
            </a>
          </div>
        </div>

        <div class="ex-ch ex-ch1" aria-hidden="true" data-ch-block="1">
          <p class="ex-eyebrow">01 — Notas de salida</p>
          <h2 class="ex-h2 ex-serif">
            El primer <em>impacto.</em>
          </h2>
          <p class="ex-lead">
            Lo que despierta en los primeros segundos: chispa, frescura y carácter.
          </p>
          <ul class="ex-notes">
            <li>Bergamota</li>
            <li>Pimienta rosa</li>
            <li>Cardamomo</li>
          </ul>
        </div>

        <div class="ex-ch ex-ch2" aria-hidden="true" data-ch-block="2">
          <p class="ex-eyebrow">02 — Notas de corazón</p>
          <h2 class="ex-h2 ex-serif">
            La <em>personalidad.</em>
          </h2>
          <p class="ex-lead">El alma de la fragancia: se revela despacio y define quién eres.</p>
          <ul class="ex-notes">
            <li>Rosa negra</li>
            <li>Oud</li>
            <li>Incienso</li>
          </ul>
        </div>

        <div class="ex-ch ex-ch3" aria-hidden="true" data-ch-block="3">
          <p class="ex-eyebrow">03 — Notas de fondo</p>
          <h2 class="ex-h2 ex-serif">
            La <em>estela</em> que te recuerda.
          </h2>
          <p class="ex-lead">Lo que queda cuando ya te fuiste. Profundo, cálido, inolvidable.</p>
          <ul class="ex-notes">
            <li>Ámbar</li>
            <li>Cuero</li>
            <li>Vainilla</li>
          </ul>
          <div class="ex-ctas">
            <a class="ex-btn ex-btn-primary" href="#coleccion">
              Descubre tu firma{' '}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="ex-rail" aria-hidden="true">
        <div class="ex-rail-in ex-in-fade" style="--d: .8s">
          <span class="ex-r0">00</span>
          <span class="ex-r1">01</span>
          <div class="ex-rail-track">
            <i></i>
          </div>
          <span class="ex-r2">02</span>
          <span class="ex-r3">03</span>
        </div>
      </div>
      <div class="ex-bar-mobile" aria-hidden="true">
        <i></i>
      </div>

      <div class="ex-hint" aria-hidden="true">
        <div class="ex-hint-in ex-in-fade" style="--d: 1s">
          Desliza<i></i>
        </div>
      </div>
    </div>
  </section>

  <section class="ex-after" id="coleccion">
    <p class="ex-eyebrow">La colección</p>
    <h2 class="ex-h2 ex-serif">
      Fragancias que no piden <em>permiso.</em>
    </h2>
    <a class="ex-btn ex-btn-ghost" href="#coleccion">
      Ver todas las fragancias
    </a>
    <button class="ex-replay" type="button" data-replay>
      Ver la intro de nuevo
    </button>
  </section>
</ex-hero>

<script>
  /* Controla la animación ligada al scroll. Escribe en <ex-hero> las variables CSS
     --p (progreso 0 → 1 dentro de la sección fija) y --a0..--a3 (visibilidad de cada
     capítulo), y el atributo data-ch con el capítulo activo. Todo lo demás lo hace el CSS. */
  const RANGES: ReadonlyArray<readonly [number, number]> = [
    [-1, 0.2],
    [0.27, 0.47],
    [0.54, 0.72],
    [0.79, 2],
  ]; // tramos de cada capítulo
  const FADE = 0.06; // duración del fundido entre capítulos

  class ExHero extends HTMLElement {
    private raf = 0;
    private current = -1;
    private stage: HTMLElement | null = null;
    private blocks: NodeListOf<HTMLElement> | null = null;
    private replayButton: HTMLButtonElement | null = null;

    private readonly onScroll = () => {
      if (!this.raf) this.raf = requestAnimationFrame(this.update);
    };

    // "Ver la intro de nuevo": reemplaza el hero por una copia para reiniciar las animaciones CSS.
    // La copia se conecta (connectedCallback) y el original se desconecta (disconnectedCallback).
    private readonly onReplay = () => {
      window.scrollTo(0, 0);
      this.replaceWith(this.cloneNode(true));
    };

    private readonly update = () => {
      this.raf = 0;
      const stage = this.stage;
      if (!stage) return;
      const r = stage.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const total = r.height - vh;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      let best = 0;
      let bestA = -1;
      for (let i = 0; i < RANGES.length; i++) {
        const [start, end] = RANGES[i];
        let a = Math.min((p - start) / FADE, (end - p) / FADE);
        a = Math.max(0, Math.min(1, a));
        this.style.setProperty('--a' + i, a.toFixed(3));
        if (a > bestA) {
          bestA = a;
          best = i;
        }
      }
      this.style.setProperty('--p', p.toFixed(4));
      if (best !== this.current) {
        this.current = best;
        this.setAttribute('data-ch', String(best));
        this.blocks?.forEach((block) => {
          block.setAttribute(
            'aria-hidden',
            block.getAttribute('data-ch-block') === String(best) ? 'false' : 'true',
          );
        });
      }
    };

    connectedCallback() {
      this.stage = this.querySelector<HTMLElement>('[data-stage]');
      if (!this.stage) return;
      this.blocks = this.querySelectorAll<HTMLElement>('[data-ch-block]');
      this.current = -1;
      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onScroll);
      this.update();
      this.replayButton = this.querySelector<HTMLButtonElement>('[data-replay]');
      this.replayButton?.addEventListener('click', this.onReplay);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onScroll);
      this.replayButton?.removeEventListener('click', this.onReplay);
      if (this.raf) cancelAnimationFrame(this.raf);
      this.raf = 0;
      this.stage = null;
      this.blocks = null;
      this.replayButton = null;
    }
  }

  if (!customElements.get('ex-hero')) customElements.define('ex-hero', ExHero);
</script>

<style>
  /* Excentrix — Hero animado (intro + scroll). Estilos aislados: alcance de Astro + prefijo ex-. */

  /* ───── Root & tokens ───── */
  .ex {
    --red: #8e1b24;
    --intro: 2.75s;
    --p: 0;
    --a0: 1;
    --a1: 0;
    --a2: 0;
    --a3: 0;
    --ink: #f4efe9;
    --muted: rgba(244, 239, 233, 0.68);
    --bg: #0b0a0a;
    --red2: #e2707a;
    display: block;
    position: relative;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 300;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }
  .ex-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  /* ───── Onboarding / preloader ───── */
  .ex-pre {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #0b0a0a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    animation: ex-pre-out 0.95s cubic-bezier(0.77, 0, 0.18, 1) 2.45s forwards;
  }
  .ex-pre-iso {
    position: relative;
    width: min(150px, 34vw);
    aspect-ratio: 322.5/425.25;
    animation: ex-pre-iso 0.95s cubic-bezier(0.77, 0, 0.18, 1) 2.45s forwards;
  }
  .ex-pre-iso img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ex-pre-bottle {
    clip-path: inset(100% 0 0 0);
    animation: ex-reveal-up 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.25s forwards;
  }
  .ex-pre-swirl {
    clip-path: inset(0 0 100% 0);
    opacity: 0;
    filter: blur(6px);
    animation: ex-swirl-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) 1s forwards;
  }
  .ex-pre-word {
    width: min(260px, 58vw);
    clip-path: inset(0 100% 0 0);
    animation: ex-reveal-right 1s cubic-bezier(0.65, 0, 0.35, 1) 1.35s forwards;
  }
  .ex-pre-bar {
    width: min(220px, 50vw);
    height: 1px;
    background: rgba(244, 239, 233, 0.14);
    overflow: hidden;
  }
  .ex-pre-bar i {
    display: block;
    height: 100%;
    background: var(--red2);
    transform: scaleX(0);
    transform-origin: left;
    animation: ex-bar 2.2s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }
  @keyframes ex-reveal-up {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes ex-reveal-right {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes ex-swirl-in {
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      filter: blur(0);
    }
  }
  @keyframes ex-bar {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes ex-pre-iso {
    to {
      transform: translateY(-40px) scale(0.9);
      opacity: 0;
    }
  }
  @keyframes ex-pre-out {
    0% {
      clip-path: inset(0 0 0 0);
    }
    99% {
      clip-path: inset(0 0 100% 0);
    }
    100% {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }

  /* ───── Entrance (after intro) ───── */
  .ex-in {
    opacity: 0;
    animation: ex-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--intro) + var(--d, 0s));
  }
  .ex-in-fade {
    opacity: 0;
    animation: ex-fade-in 1.2s ease both;
    animation-delay: calc(var(--intro) + var(--d, 0s));
  }
  @keyframes ex-fade-in {
    to {
      opacity: 1;
    }
  }
  .ex-rail-in,
  .ex-hint-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: inherit;
  }
  .ex-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .ex-line > span {
    display: inline-block;
    transform: translateY(110%);
    animation: ex-line-up 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--intro) + var(--d, 0s));
  }
  .ex-bottle-in {
    opacity: 0;
    animation: ex-bottle-in 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--intro) - 0.15s);
  }
  @keyframes ex-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ex-line-up {
    to {
      transform: translateY(0);
    }
  }
  @keyframes ex-bottle-in {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.86);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  /* ───── Scroll stage (pinned) ───── */
  .ex-stage {
    position: relative;
    height: 420vh;
  }
  .ex-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .ex-glow {
    position: absolute;
    width: min(70vw, 900px);
    aspect-ratio: 1;
    right: 2vw;
    top: 50%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(142, 27, 36, 0.55),
      rgba(142, 27, 36, 0.12) 55%,
      transparent 72%
    );
    transform: translateY(-50%) scale(calc(0.8 + var(--p) * 0.6));
    opacity: calc(0.55 + var(--p) * 0.45);
    pointer-events: none;
  }
  .ex-outline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    white-space: nowrap;
    font-size: clamp(7rem, 24vw, 26rem);
    line-height: 1;
    font-weight: 300;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 239, 233, 0.09);
    transform: translateX(calc(4vw - var(--p) * 55%));
    pointer-events: none;
    user-select: none;
  }

  .ex-puffs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(0.25 + var(--p) * 0.75);
  }
  .ex-puff {
    position: absolute;
    bottom: -10%;
    left: var(--x);
    width: var(--s);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(194, 58, 68, 0.55), transparent);
    filter: blur(18px);
    opacity: 0;
    animation: ex-drift var(--dur) linear var(--dl) infinite;
  }
  @keyframes ex-drift {
    0% {
      transform: translateY(0) scale(0.6);
      opacity: 0;
    }
    20% {
      opacity: 0.7;
    }
    100% {
      transform: translateY(-120vh) translateX(40px) scale(1.6);
      opacity: 0;
    }
  }

  .ex-iso-wrap {
    position: absolute;
    right: clamp(4vw, 9vw, 160px);
    top: 50%;
    width: clamp(240px, 27vw, 420px);
    aspect-ratio: 322.5/425.25;
    transform: translateY(calc(-50% - var(--p) * 4%)) scale(calc(1 + var(--p) * 0.2))
      rotate(calc(var(--p) * -7deg));
  }
  .ex-iso {
    position: absolute;
    inset: 0;
  }
  .ex-iso img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .ex-swirl {
    transform-origin: 55% 100%;
    transform: translateY(calc(var(--p) * -6%)) scale(calc(1 + var(--p) * 0.35));
    filter: drop-shadow(0 0 calc(var(--p) * 18px) rgba(226, 112, 122, 0.65));
  }
  .ex-swirl-ghost {
    transform-origin: 55% 90%;
    transform: translateY(calc(var(--p) * -22%)) scale(calc(1.1 + var(--p) * 1.1));
    filter: blur(calc(4px + var(--p) * 10px));
    opacity: calc(var(--p) * 0.7);
  }
  .ex-shard {
    position: absolute;
    background: var(--ink);
    opacity: calc(var(--p) * 5);
    transform: translate(calc(var(--p) * var(--dx)), calc(var(--p) * var(--dy)))
      rotate(calc(var(--p) * var(--r)));
  }

  /* chapters */
  .ex-copy {
    position: absolute;
    left: clamp(20px, 6vw, 104px);
    top: 50%;
    transform: translateY(-50%);
    width: min(560px, 46vw);
    height: min(560px, 70vh);
  }
  .ex-ch {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    pointer-events: none;
  }
  .ex-ch1 {
    opacity: var(--a1);
    transform: translateY(calc((1 - var(--a1)) * 30px));
  }
  .ex-ch2 {
    opacity: var(--a2);
    transform: translateY(calc((1 - var(--a2)) * 30px));
  }
  .ex-ch3 {
    opacity: var(--a3);
    transform: translateY(calc((1 - var(--a3)) * 30px));
  }
  .ex-ch0 {
    opacity: var(--a0);
    transform: translateY(calc((1 - var(--a0)) * -30px));
  }
  .ex[data-ch='0'] .ex-ch0,
  .ex[data-ch='3'] .ex-ch3 {
    pointer-events: auto;
  }
  .ex-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--red2);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
  }
  .ex-eyebrow::before {
    content: '';
    width: 36px;
    height: 1px;
    background: currentColor;
  }
  /* letter-spacing y text-wrap neutralizan la base global de h1/h2 del sitio */
  .ex-h1 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(3.2rem, 7.4vw, 7.6rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-wrap: wrap;
  }
  .ex-h2 {
    margin: 0;
    font-weight: 300;
