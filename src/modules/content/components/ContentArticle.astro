---
import { routes } from '@shared/config/routes';
import Container from '@shared/ui/Container.astro';
import type { ContentPage } from '../schemas';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
---

<article class="py-12 sm:py-20">
  <Container width="narrow" class="flex flex-col gap-12">
    <header class="flex flex-col gap-6 border-b border-line pb-10">
      <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-xs text-ink-soft">
          <li>
            <a href={routes.home} class="hover:text-ink">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">
            {page.title}
          </li>
        </ol>
      </nav>
      <p class="eyebrow flex items-center gap-3 text-ink-soft">
        <span aria-hidden="true" class="h-px w-8 bg-crimson"></span>
        {page.eyebrow}
      </p>
      <h1 class="text-4xl leading-tight sm:text-6xl">{page.title}</h1>
      <p class="text-lg leading-relaxed text-ink-soft">{page.intro}</p>
    </header>
    {page.sections.map((s) => (
      <section class="flex flex-col gap-4">
        <h2 class="text-2xl sm:text-3xl">{s.heading}</h2>
        {s.paragraphs.map((p) => (
          <p class="text-base leading-relaxed text-ink-soft">{p}</p>
        ))}
      </section>
    ))}
  </Container>
</article>
