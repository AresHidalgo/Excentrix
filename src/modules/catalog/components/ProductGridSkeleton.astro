---
/** Esqueleto de carga para grillas de perfumes (búsqueda y filtros en fases siguientes). */
interface Props {
  count?: number;
}

const { count = 4 } = Astro.props;
---

<div role="status" aria-live="polite">
  <span class="sr-only">Cargando perfumes…</span>
  <ul
    aria-hidden="true"
    class="grid grid-cols-2 gap-x-3 gap-y-6 sm:gap-x-5 sm:gap-y-10 md:grid-cols-3 lg:grid-cols-4"
  >
    {Array.from({ length: count }, () => (
      <li class="flex animate-pulse flex-col bg-white">
        <div class="aspect-[4/5] bg-line/50" />
        <div class="flex flex-col gap-3 border-t border-line px-4 pt-4 pb-5">
          <div class="h-2 w-1/3 bg-line" />
          <div class="h-4 w-3/4 bg-line" />
          <div class="h-3 w-1/2 bg-line" />
        </div>
      </li>
    ))}
  </ul>
</div>
