# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Dominio público del sitio (canónicas, sitemap, Open Graph, enlaces de WhatsApp)
PUBLIC_SITE_URL=https://excentrix.web.app

# Firebase (configuración web, es pública por diseño; la seguridad la dan las reglas)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudinary (solo el nombre de la cuenta es público; la API secret vive en el Worker)
PUBLIC_CLOUDINARY_CLOUD_NAME=

# URL del Cloudflare Worker (firma de subidas y botón Publicar)
PUBLIC_WORKER_URL=

# Solo para el build: cuenta de servicio de Firebase (JSON en una línea). En CI va en GitHub Secrets.
FIREBASE_SERVICE_ACCOUNT=
