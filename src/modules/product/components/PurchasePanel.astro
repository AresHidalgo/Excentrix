---
import { routes } from '@shared/config/routes';
import {
  buildAvailabilityMessage,
  buildWhatsAppMessage,
  buildWhatsAppUrl,
  WHATSAPP_PHONE,
} from '@modules/whatsapp';
import { LINE_LABEL, LINE_NOTICE, LINE_ORDER } from '../lib/lines';
import { cheapestVariant, variantDiscount } from '../lib/pricing';
import type { Perfume } from '../schemas';
import PresentationSelector, { type PresentationOption } from './PresentationSelector.tsx';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const url = new URL(routes.perfume(perfume.slug), Astro.site).href;

// Los enlaces de WhatsApp se arman aquí (servidor) para que la isla no importe otros módulos.
// Orden: por línea (inspiración, réplica 1.1, original), luego decants antes que frascos, luego ml.
const typeRank = (t: string) => (t === 'decant' ? 0 : 1);
const ordered = [...perfume.variants].sort(
  (a, b) =>
    LINE_ORDER.indexOf(a.line) - LINE_ORDER.indexOf(b.line) ||
    typeRank(a.type) - typeRank(b.type) ||
    a.ml - b.ml,
);
// Con una sola línea "original" (datos de muestra) se conserva el título clásico del grupo.
const showLineTitles = !(perfume.lines.length === 1 && perfume.lines[0] === 'original');
const options: PresentationOption[] = ordered.map((v) => ({
  id: v.id,
  groupKey: `${v.line}:${v.type}`,
  groupTitle:
    v.type === 'decant' ? 'Decant' : showLineTitles ? LINE_LABEL[v.line] : 'Frasco completo',
  groupNotice: showLineTitles ? LINE_NOTICE[v.line] : null,
  type: v.type,
  ml: v.ml,
  tester: v.condition === 'tester',
  price: v.price,
  compareAtPrice: v.compareAtPrice,
  discount: variantDiscount(v),
  available: v.available,
  whatsappUrl: buildWhatsAppUrl(WHATSAPP_PHONE, buildWhatsAppMessage({ perfume, variant: v, url })),
}));

const leadTimeLabel = perfume.badges.includes('preventa')
  ? 'Preventa'
  : perfume.badges.includes('bajo-encargo')
    ? 'Bajo encargo'
    : null;
---

<PresentationSelector
  client:idle
  options={options}
  defaultId={cheapestVariant(perfume)?.id ?? null}
  availabilityUrl={buildWhatsAppUrl(WHATSAPP_PHONE, buildAvailabilityMessage(perfume, url))}
  leadTime={perfume.leadTime}
  leadTimeLabel={leadTimeLabel}
  decantInfoHref={routes.page('que-es-un-decant')}
/>
